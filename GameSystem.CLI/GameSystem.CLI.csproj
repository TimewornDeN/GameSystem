<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameSystem</AssemblyName>
    <RootNamespace>GameSystem.CLI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSystem.Core\GameSystem.Core.csproj" />
    <ProjectReference Include="..\GameSystem.Infra\GameSystem.Infra.csproj" />
  </ItemGroup>

  <!-- Sample character profiles are copied next to the program (build and publish), so the 'import' command finds them. -->
  <ItemGroup>
    <None Include="..\samples\characters\*.json" Link="characters\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
